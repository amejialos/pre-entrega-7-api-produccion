# Copiá este archivo a .env y completá las keys. El .env NUNCA se sube a git.

# --- Pinecone (el índice que creó y llenó la Pre-entrega 4) ---
PINECONE_API_KEY=<tu-key-de-pinecone>
INDEX_NAME=pre-entrega-4
PINECONE_NAMESPACE=caudal-docs

# --- Modelo de chat y embeddings (cualquier endpoint compatible con la API de OpenAI) ---
OPENAI_API_KEY=<tu-key-de-openai-o-gemini>
OPENAI_MODEL=gpt-4o-mini
# Para usar Gemini gratis (Google AI Studio):
#   OPENAI_API_KEY=<tu key de Gemini>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=
# Embeddings: gemini-embedding-001 si hay OPENAI_BASE_URL, text-embedding-3-small si no.
# EMBEDDING_MODEL=

# Modelo por rol (si no están, se usa OPENAI_MODEL). Con el free tier de Gemini conviene
# repartir: la cuota (por día y por minuto) se cuenta por modelo.
# SUPERVISOR_MODEL=gemini-flash-lite-latest
# RESEARCH_MODEL=gemini-3.5-flash-lite
# ANALYST_MODEL=gemini-3.1-flash-lite
# SYNTH_MODEL=gemini-3.1-flash-lite
# Máximo de pedidos por minuto POR MODELO (free tier de Gemini: ~5 RPM).
# LLM_RPM=4
# Método de salida estructurada del supervisor: json_schema (default) o function_calling.
# SUPERVISOR_STRUCTURED_METHOD=

# --- Redis: estado de los jobs, cola del worker y checkpoints de LangGraph ---
# Necesita los módulos JSON y Search (la imagen redis:8 del docker-compose ya los trae).
REDIS_URL=redis://localhost:6379/0

# --- Worker ---
# Jobs que corren a la vez dentro del proceso de la API.
WORKER_CONCURRENCY=5
# 0 = la API solo encola; los jobs los corren procesos `uv run python -m app.worker`.
# WORKER_EMBEBIDO=1

# --- Observabilidad: Arize Phoenix (OpenInference) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=pe7-api-agente
# TRACING_ENABLED=0 apaga las trazas.
# TRACING_ENABLED=1
